{
  "name": "smtmtc-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node scripts/run.mjs astro dev",
    "build": "node scripts/run.mjs astro build",
    "preview": "node scripts/run.mjs astro preview",
    "check": "node scripts/run.mjs astro check",
    "test": "npm run build && node scripts/run.mjs test",
    "worker:dev": "npm run build && node scripts/run.mjs wrangler dev",
    "deploy": "npm run build && node scripts/run.mjs wrangler deploy"
  },
  "dependencies": {
    "astro": "7.3.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4"
  },
  "devDependencies": {
    "node": "22.23.3",
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.151.0"
  }
}
