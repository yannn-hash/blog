# Astro tidak membutuhkan secrets. OAuth hanya dibaca oleh Worker.
# Untuk Wrangler lokal, salin placeholder ini ke .dev.vars (diabaikan Git).
GITHUB_CLIENT_ID=isi-client-id-oauth-app
GITHUB_CLIENT_SECRET=isi-client-secret-oauth-app
CMS_SESSION_SECRET=ganti-dengan-random-secret-minimal-32-karakter
# Deploy berkelompok: semua ini binding runtime Worker, bukan PUBLIC_ atau build vars.
# Hook harus untuk Worker smtmtc-blog dan branch main. Gunakan prompt secret put di produksi.
CMS_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/workers/builds/deploy_hooks/00000000-0000-0000-0000-000000000000
CLOUDFLARE_BUILDS_READ_TOKEN=isi-token-user-scoped-workers-ci-read
# ID nonrahasia: tambahkan nilai nyata ke vars wrangler.jsonc sebelum deploy produksi.
CLOUDFLARE_ACCOUNT_ID=isi-account-id-32-hex
CLOUDFLARE_WORKER_TAG=isi-worker-tag-32-hex-bukan-nama-worker
