---
const path = Astro.url.pathname;
const links = [
  { href: '/blog/', label: 'Tulisan' },
  { href: '/tag/', label: 'Topik' },
  { href: '/tentang/', label: 'Tentang' },
  { href: '/cari/', label: 'Cari' },
];
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="smtmtc — beranda">smtmtc<span aria-hidden="true">.</span></a>
  <nav aria-label="Navigasi utama">
    {links.map(({ href, label }) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
  </nav>
</header>
