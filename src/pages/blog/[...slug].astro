---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicPosts, formatDate, tagUrl, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getPublicPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: Post; }
const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description} article>
  <article class="article-page">
    <header class="article-heading">
      <a class="back-link" href="/blog/">← Semua tulisan</a>
      <div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>Oleh Riskiyanto</span></div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <ul class="tags" aria-label="Topik artikel">{post.data.tags.map((tag) => <li><a href={tagUrl(tag)}>{tag.replaceAll('-', ' ')}</a></li>)}</ul>
    </header>
    {post.data.example && <aside class="example-note"><strong>Artikel contoh.</strong> Tulisan ini disiapkan sebagai contoh isi dan format blog, bukan cerita pengalaman pribadi Riskiyanto.</aside>}
    <div class="prose"><Content /></div>
    <div class="article-end"><p>Terima kasih sudah membaca.</p><a class="text-link" href="/blog/">Lanjut ke tulisan lainnya →</a></div>
  </article>
</BaseLayout>
